node_modules/
dist/
server/data/
# 根目录 data/：本地运行库与备份（icpc.db、backups、uploads），绝不入库
data/
server/config.json
*.log
.DS_Store
.reasonix/

# 本地内部文档，不入库
icpc-workbench-*.md

# SEA 打包产物（90MB exe），本地构建生成
server/release/
server/vendor/typst/
.zcode/

# 代码签名证书（含私钥，绝不入库）
server/certs/

# 临时验证脚本
server/tmp-*

# 工具链残留：某些工具在路径变量取值为空时会把字面量 "undefined" 当作目录名，
# 生成 <workspace>/undefined/temp/tsx-* 编译缓存（相对路径解析失败所致），非源码
undefined/

# 本地录屏/视频素材，不入库
videos/

# 本地 AI 代理工具的会话上传/记忆目录，非项目源码
.dsh-uploads/
.workbuddy/
.superpowers/
.scratch/

# 本地诊断脚本（抓包/接口探测），非项目源码
.probe/

# AlgoWiki 对照用的原始抓取快照（180 条，含第三方贡献者的昵称/学校/头像/bio），
# 仅作一次性比对依据，不被任何代码读取；不入库以免把他人个人信息发到公开仓库
scripts/algowiki-tricks-raw.json

# 渲染验证脚本的临时编译产物（client/test/renderCheck.mjs 每次运行重新生成）
client/test/.render-out/

