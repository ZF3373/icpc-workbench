{
  "name": "icpc-workbench",
  "version": "0.4.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "npm run lint -w client",
    "test": "npm run test -w server && npm run test -w client",
    "build:desktop": "node server/scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.4",
    "concurrently": "^9.1.2"
  }
}
